{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "default",
      "inherits": "base",
      "displayName": "Default (RelWithDebInfo)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "dev",
      "inherits": "base",
      "displayName": "Development (Debug, warnings, memory checks)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SERVICES_WARNINGS": "ON",
        "SERVICES_MEMCHECKS": "ON"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "Development with AddressSanitizer/UBSan",
      "description": "Run with ASAN_OPTIONS=detect_odr_violation=0: every module defines module_config.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release (optimised)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "dev", "configurePreset": "dev" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "release", "configurePreset": "release" }
  ]
}
